{
  "name": "sanchong-online",
  "version": "1.0.0",
  "private": true,
  "description": "中山三鄉睇樓評分表 (online) — Cloudflare Workers + D1 + R2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute sanchong-db --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute sanchong-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
